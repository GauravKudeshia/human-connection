# Local or isolated staging only. Copy to .dev.vars and keep it ignored.
HC_MARKETPLACE_ENABLED=false
MARKETPLACE_MODE=staging
# Provision a separate D1 binding named MARKETPLACE_DB.
# Apply db/marketplace.sql to that binding before enabling the staging API.
MARKETPLACE_AUTH_ISSUER=https://your-tenant.example.invalid/
MARKETPLACE_AUTH_AUDIENCE=human-connection-staging
MARKETPLACE_AUTH_JWKS_URL=https://your-tenant.example.invalid/.well-known/jwks.json
MARKETPLACE_AUTH_CLIENT_ID=
MARKETPLACE_AUTH_CLIENT_SECRET=
MARKETPLACE_APP_ORIGIN=http://127.0.0.1:4212
# Base64-encoded 32-byte random key, kept only in server secret storage.
MARKETPLACE_SESSION_SECRET=
# Server-only Stripe sandbox account credentials.
STRIPE_SANDBOX_SECRET_KEY=
STRIPE_SANDBOX_WEBHOOK_SECRET=
STRIPE_SANDBOX_PUBLISHABLE_KEY=
# Daily creates real provider resources. Use an expressly authorized test account.
DAILY_API_KEY=
DAILY_ALLOW_TEST_ROOMS=false
DAILY_WEBHOOK_SECRET=
# Authorized test delivery destination only. In-app outbox works without it.
NOTIFICATION_MODE=disabled
NOTIFICATION_DELIVERY_URL=
NOTIFICATION_DELIVERY_SECRET=
# Optional test bindings are MARKETPLACE_DB and MARKETPLACE_MEDIA.
# Live funds, payouts and stranger calls have no enabled implementation.
